rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global safety net — default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Startup connectivity check document
    match /test/connection {
      allow get: if true;
    }

    // Hardened global helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isVerifiedFounder() {
      return isSignedIn()
        && request.auth.token.email == "gersonjcumbane@gmail.com"
        && request.auth.token.email_verified == true;
    }

    function isSuperAdmin() {
      return isVerifiedFounder() || (
        isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // User entity validator
    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'email', 'role', 'createdAt', 'status'])
        && data.keys().hasOnly(['uid', 'email', 'role', 'companyId', 'createdAt', 'status'])
        && data.uid is string && data.uid.size() > 0 && data.uid.size() <= 128
        && data.email is string && data.email.size() > 0 && data.email.size() <= 256
        && data.role in ['SUPER_ADMIN_PAYROLL', 'CLIENTE_EMPRESA']
        && (!('companyId' in data) || (data.companyId is string && data.companyId.size() <= 128))
        && data.createdAt is string && data.createdAt.size() <= 64
        && data.status in ['ativo', 'suspenso', 'pendente'];
    }

    // ClientCompany validator (/erp_clients)
    function isValidClientCompany(data) {
      return data.keys().hasAll(['id', 'nome', 'nuit', 'email', 'subscription_plan', 'subscription_status', 'fee_base', 'updatedAt'])
        && data.keys().hasOnly(['id', 'nome', 'nuit', 'email', 'telefone', 'passwordHash', 'subscription_plan', 'subscription_status', 'fee_base', 'logo', 'updatedAt'])
        && data.id is string && data.id.size() > 0 && data.id.size() <= 128
        && data.nome is string && data.nome.size() > 0 && data.nome.size() <= 256
        && data.nuit is string && data.nuit.size() <= 32
        && data.email is string && data.email.size() <= 256
        && (!('telefone' in data) || (data.telefone is string && data.telefone.size() <= 64))
        && (!('passwordHash' in data) || (data.passwordHash is string && data.passwordHash.size() <= 256))
        && data.subscription_plan in ['Starter', 'Growth', 'Business', 'Bronze', 'Silver', 'Gold', 'Platinum']
        && data.subscription_status in ['ativo', 'suspenso', 'pendente']
        && data.fee_base is number && data.fee_base >= 0 && data.fee_base <= 1000000
        && (!('logo' in data) || (data.logo is string && data.logo.size() <= 150000))
        && data.updatedAt is string && data.updatedAt.size() <= 64;
    }

    // SaasClient validator (/saas_clients)
    function isValidSaasClient(data) {
      return data.keys().hasAll(['email', 'updatedAt'])
        && data.keys().hasOnly(['id', 'companyName', 'tradeName', 'nuit', 'email', 'phone', 'address', 'plan', 'monthlyFee', 'status', 'adminName', 'adminPassword', 'role', 'nextBillingDate', 'logo', 'createdAt', 'updatedAt'])
        && (!('id' in data) || (data.id is string && data.id.size() <= 128))
        && (!('companyName' in data) || (data.companyName is string && data.companyName.size() <= 256))
        && (!('tradeName' in data) || (data.tradeName is string && data.tradeName.size() <= 256))
        && (!('nuit' in data) || (data.nuit is string && data.nuit.size() <= 32))
        && data.email is string && data.email.size() <= 256
        && (!('phone' in data) || (data.phone is string && data.phone.size() <= 64))
        && (!('address' in data) || (data.address is string && data.address.size() <= 512))
        && (!('plan' in data) || (data.plan is string && data.plan.size() <= 64))
        && (!('monthlyFee' in data) || (data.monthlyFee is number && data.monthlyFee >= 0 && data.monthlyFee <= 1000000))
        && (!('status' in data) || data.status in ['Ativo', 'Suspenso', 'Pendente', 'ativo', 'suspenso', 'pendente'])
        && (!('adminName' in data) || (data.adminName is string && data.adminName.size() <= 256))
        && (!('adminPassword' in data) || (data.adminPassword is string && data.adminPassword.size() <= 256))
        && (!('role' in data) || (data.role is string && data.role.size() <= 64))
        && (!('nextBillingDate' in data) || (data.nextBillingDate is string && data.nextBillingDate.size() <= 64))
        && (!('logo' in data) || (data.logo is string && data.logo.size() <= 150000))
        && (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 64))
        && data.updatedAt is string && data.updatedAt.size() <= 64;
    }

    // CloudBackup validator (/erp_backups)
    function isValidCloudBackup(data) {
      return data.keys().hasAll(['id', 'empresaId', 'empresaNome', 'timestamp', 'tipo', 'quantidadeColaboradores', 'quantidadeLancamentos', 'tamanhoKb', 'snapshotJson'])
        && data.keys().hasOnly(['id', 'empresaId', 'empresaNome', 'timestamp', 'tipo', 'quantidadeColaboradores', 'quantidadeLancamentos', 'tamanhoKb', 'snapshotJson'])
        && data.id is string && data.id.size() > 0 && data.id.size() <= 128
        && data.empresaId is string && data.empresaId.size() > 0 && data.empresaId.size() <= 128
        && data.empresaNome is string && data.empresaNome.size() <= 256
        && data.timestamp is string && data.timestamp.size() <= 64
        && data.tipo is string && data.tipo.size() <= 128
        && data.quantidadeColaboradores is number && data.quantidadeColaboradores >= 0
        && data.quantidadeLancamentos is number && data.quantidadeLancamentos >= 0
        && data.tamanhoKb is number && data.tamanhoKb >= 0
        && data.snapshotJson is string && data.snapshotJson.size() <= 900000;
    }

    // BackupRecord validator (/backups)
    function isValidBackupRecord(data) {
      return data.keys().hasAll(['id', 'empresaId', 'empresaNome', 'timestamp', 'tipo', 'quantidadeColaboradores', 'quantidadeLancamentos', 'tamanhoKb', 'syncedWithFirebase', 'createdAt'])
        && data.keys().hasOnly(['id', 'empresaId', 'empresaNome', 'timestamp', 'tipo', 'quantidadeColaboradores', 'quantidadeLancamentos', 'tamanhoKb', 'syncedWithFirebase', 'createdAt'])
        && data.id is string && data.id.size() > 0 && data.id.size() <= 128
        && data.empresaId is string && data.empresaId.size() > 0 && data.empresaId.size() <= 128
        && data.empresaNome is string && data.empresaNome.size() <= 256
        && data.timestamp is string && data.timestamp.size() <= 64
        && data.tipo is string && data.tipo.size() <= 128
        && data.quantidadeColaboradores is number && data.quantidadeColaboradores >= 0
        && data.quantidadeLancamentos is number && data.quantidadeLancamentos >= 0
        && data.tamanhoKb is number && data.tamanhoKb >= 0
        && data.syncedWithFirebase is bool
        && data.createdAt is string && data.createdAt.size() <= 64;
    }

    // CredentialRequest validator (/erp_credential_requests)
    function isValidCredentialRequest(data) {
      return data.keys().hasAll(['id', 'nomeEmpresa', 'nomeResponsavel', 'email', 'telefone', 'planoEscolhido', 'precoMensal', 'status', 'dataSolicitacao'])
        && data.keys().hasOnly([
          'id', 'nomeEmpresa', 'nomeResponsavel', 'email', 'telefone', 'nuit',
          'planoEscolhido', 'cicloFaturacao', 'precoMensal',
          'metodoTransferencia', 'referenciaTransferencia', 'valorTransferido',
          'dataTransferencia', 'comprovativoNome', 'activationCodePrefix',
          'motivoRejeicao', 'aprovadoEm', 'status', 'dataSolicitacao'
        ])
        && data.id is string && data.id.size() > 0 && data.id.size() <= 128
        && data.nomeEmpresa is string && data.nomeEmpresa.size() <= 256
        && data.nomeResponsavel is string && data.nomeResponsavel.size() <= 256
        && data.email is string && data.email.size() <= 256
        && data.telefone is string && data.telefone.size() <= 64
        && (!('nuit' in data) || (data.nuit is string && data.nuit.size() <= 32))
        && data.planoEscolhido is string && data.planoEscolhido.size() <= 64
        && (!('cicloFaturacao' in data) || data.cicloFaturacao in ['mensal', 'anual'])
        && data.precoMensal is number && data.precoMensal >= 0 && data.precoMensal <= 1000000
        && (!('metodoTransferencia' in data) || (data.metodoTransferencia is string && data.metodoTransferencia.size() <= 64))
        && (!('referenciaTransferencia' in data) || (data.referenciaTransferencia is string && data.referenciaTransferencia.size() <= 128))
        && (!('valorTransferido' in data) || (data.valorTransferido is number && data.valorTransferido >= 0 && data.valorTransferido <= 10000000))
        && (!('dataTransferencia' in data) || (data.dataTransferencia is string && data.dataTransferencia.size() <= 64))
        && (!('comprovativoNome' in data) || (data.comprovativoNome is string && data.comprovativoNome.size() <= 256))
        && (!('activationCodePrefix' in data) || (data.activationCodePrefix is string && data.activationCodePrefix.size() <= 32))
        && (!('motivoRejeicao' in data) || (data.motivoRejeicao is string && data.motivoRejeicao.size() <= 512))
        && (!('aprovadoEm' in data) || (data.aprovadoEm is string && data.aprovadoEm.size() <= 64))
        && data.status in ['PENDENTE', 'PENDENTE_PAGAMENTO', 'APROVADO', 'CREDENCIAIS_ENVIADAS', 'REJEITADO']
        && data.dataSolicitacao is string && data.dataSolicitacao.size() <= 64;
    }

    // LandingCredentialRequest validator (/credential_requests)
    function isValidLandingCredentialRequest(data) {
      return data.keys().hasAll(['id', 'empresa', 'email', 'plano', 'status', 'createdAt'])
        && data.keys().hasOnly([
          'id', 'empresa', 'responsavel', 'nuit', 'email', 'telefone', 'plano',
          'cicloFaturacao', 'metodoTransferencia', 'referenciaTransferencia',
          'valorTransferido', 'dataTransferencia', 'comprovativoNome',
          'activationCodePrefix', 'motivoRejeicao', 'status', 'createdAt'
        ])
        && data.id is string && data.id.size() > 0 && data.id.size() <= 128
        && data.empresa is string && data.empresa.size() <= 256
        && (!('responsavel' in data) || (data.responsavel is string && data.responsavel.size() <= 256))
        && (!('nuit' in data) || (data.nuit is string && data.nuit.size() <= 32))
        && data.email is string && data.email.size() <= 256
        && (!('telefone' in data) || (data.telefone is string && data.telefone.size() <= 64))
        && data.plano is string && data.plano.size() <= 64
        && (!('cicloFaturacao' in data) || data.cicloFaturacao in ['mensal', 'anual'])
        && (!('metodoTransferencia' in data) || (data.metodoTransferencia is string && data.metodoTransferencia.size() <= 64))
        && (!('referenciaTransferencia' in data) || (data.referenciaTransferencia is string && data.referenciaTransferencia.size() <= 128))
        && (!('valorTransferido' in data) || (data.valorTransferido is number && data.valorTransferido >= 0 && data.valorTransferido <= 10000000))
        && (!('dataTransferencia' in data) || (data.dataTransferencia is string && data.dataTransferencia.size() <= 64))
        && (!('comprovativoNome' in data) || (data.comprovativoNome is string && data.comprovativoNome.size() <= 256))
        && (!('activationCodePrefix' in data) || (data.activationCodePrefix is string && data.activationCodePrefix.size() <= 32))
        && (!('motivoRejeicao' in data) || (data.motivoRejeicao is string && data.motivoRejeicao.size() <= 512))
        && data.status in ['PENDENTE', 'PENDENTE_PAGAMENTO', 'APROVADO', 'REGISTADO_ONLINE', 'CREDENCIAIS_ENVIADAS', 'REJEITADO']
        && data.createdAt is string && data.createdAt.size() <= 64;
    }

    // CompanyProfile validator (/companies)
    function isValidCompanyProfile(data) {
      return data.keys().hasAll(['nome', 'nuit', 'updatedAt'])
        && data.keys().hasOnly(['id', 'nome', 'nuit', 'email', 'plano', 'status', 'origem', 'endereco', 'pais', 'provincia', 'distrito', 'regime_iva', 'sector_negocio', 'tamanho_empresa', 'regime_fiscal_pme', 'nuel', 'telefone', 'logo', 'createdAt', 'updatedAt'])
        && (!('id' in data) || (data.id is string && data.id.size() <= 128))
        && data.nome is string && data.nome.size() > 0 && data.nome.size() <= 256
        && data.nuit is string && data.nuit.size() <= 32
        && (!('email' in data) || (data.email is string && data.email.size() <= 256))
        && (!('plano' in data) || (data.plano is string && data.plano.size() <= 64))
        && (!('status' in data) || (data.status is string && data.status.size() <= 32))
        && (!('origem' in data) || (data.origem is string && data.origem.size() <= 128))
        && (!('endereco' in data) || (data.endereco is string && data.endereco.size() <= 512))
        && (!('pais' in data) || (data.pais is string && data.pais.size() <= 128))
        && (!('provincia' in data) || (data.provincia is string && data.provincia.size() <= 128))
        && (!('distrito' in data) || (data.distrito is string && data.distrito.size() <= 128))
        && (!('regime_iva' in data) || (data.regime_iva is string && data.regime_iva.size() <= 128))
        && (!('sector_negocio' in data) || (data.sector_negocio is string && data.sector_negocio.size() <= 256))
        && (!('tamanho_empresa' in data) || (data.tamanho_empresa is string && data.tamanho_empresa.size() <= 128))
        && (!('regime_fiscal_pme' in data) || (data.regime_fiscal_pme is string && data.regime_fiscal_pme.size() <= 128))
        && (!('nuel' in data) || (data.nuel is string && data.nuel.size() <= 64))
        && (!('telefone' in data) || (data.telefone is string && data.telefone.size() <= 64))
        && (!('logo' in data) || (data.logo is string && data.logo.size() <= 150000))
        && (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 64))
        && data.updatedAt is string && data.updatedAt.size() <= 64;
    }

    // SupportTicket validator (/support_tickets)
    function isValidSupportTicket(data) {
      return data.keys().hasAll(['id', 'nome', 'email', 'telefone', 'assunto', 'prioridade', 'mensagem', 'status', 'createdAt'])
        && data.keys().hasOnly(['id', 'nome', 'empresa', 'email', 'telefone', 'assunto', 'prioridade', 'mensagem', 'canalOrigem', 'emailDestino', 'whatsappDestino', 'status', 'createdAt'])
        && data.id is string && data.id.size() > 0 && data.id.size() <= 128
        && data.nome is string && data.nome.size() > 0 && data.nome.size() <= 256
        && (!('empresa' in data) || (data.empresa is string && data.empresa.size() <= 256))
        && data.email is string && data.email.size() > 0 && data.email.size() <= 256
        && data.telefone is string && data.telefone.size() > 0 && data.telefone.size() <= 64
        && data.assunto is string && data.assunto.size() > 0 && data.assunto.size() <= 256
        && data.prioridade in ['Normal', 'Alta', 'Urgente']
        && data.mensagem is string && data.mensagem.size() > 0 && data.mensagem.size() <= 4000
        && (!('canalOrigem' in data) || (data.canalOrigem is string && data.canalOrigem.size() <= 64))
        && (!('emailDestino' in data) || (data.emailDestino is string && data.emailDestino.size() <= 256))
        && (!('whatsappDestino' in data) || (data.whatsappDestino is string && data.whatsappDestino.size() <= 64))
        && data.status in ['ABERTO', 'EM_ANALISE', 'RESOLVIDO']
        && data.createdAt is string && data.createdAt.size() <= 64;
    }

    // /admins/{adminId}
    match /admins/{adminId} {
      allow get: if isSignedIn() && request.auth.uid == adminId;
      allow list, create, update, delete: if false;
    }

    // /users/{userId}
    match /users/{userId} {
      allow get: if isSignedIn() && (request.auth.uid == userId || isSuperAdmin());
      allow list: if isSignedIn() && (resource.data.uid == request.auth.uid || isVerifiedFounder());

      allow create: if isSignedIn()
        && isValidId(userId)
        && userId == request.auth.uid
        && isValidUser(incoming())
        && incoming().uid == request.auth.uid
        && incoming().role == 'CLIENTE_EMPRESA'
        && incoming().status == 'pendente';

      allow update: if isSignedIn()
        && isValidId(userId)
        && (request.auth.uid == userId || isSuperAdmin())
        && isValidUser(incoming())
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && (
          isSuperAdmin() ||
          (incoming().role == existing().role && incoming().diff(existing()).affectedKeys().hasOnly(['companyId']))
        );

      allow delete: if isSuperAdmin();
    }

    // /erp_clients/{clientId}
    match /erp_clients/{clientId} {
      allow get: if isValidId(clientId) && (isSuperAdmin() || (isSignedIn() && resource.data.email == request.auth.token.email));
      allow list: if isVerifiedFounder() || (isSignedIn() && resource.data.email == request.auth.token.email);
      allow create: if isValidId(clientId) && isValidClientCompany(incoming()) && incoming().id == clientId
        && (isSuperAdmin() || incoming().subscription_status == 'pendente');
      allow update: if isValidId(clientId) && isValidClientCompany(incoming()) && incoming().id == existing().id && (
        isSuperAdmin() ||
        (isSignedIn() && existing().email == request.auth.token.email && incoming().subscription_status == existing().subscription_status && incoming().diff(existing()).affectedKeys().hasOnly(['nome', 'nuit', 'telefone', 'passwordHash', 'logo', 'updatedAt']))
      );
      allow delete: if isSuperAdmin();
    }

    // /saas_clients/{clientId}
    match /saas_clients/{clientId} {
      allow get: if isValidId(clientId) && (isSuperAdmin() || (isSignedIn() && resource.data.email == request.auth.token.email));
      allow list: if isVerifiedFounder() || (isSignedIn() && resource.data.email == request.auth.token.email);
      allow create: if isValidId(clientId) && isValidSaasClient(incoming())
        && (isSuperAdmin() || !('status' in incoming()) || incoming().status in ['Pendente', 'pendente']);
      allow update: if isValidId(clientId) && isValidSaasClient(incoming()) && (
        isSuperAdmin() ||
        (isSignedIn() && existing().email == request.auth.token.email && incoming().status == existing().status && incoming().diff(existing()).affectedKeys().hasOnly(['companyName', 'tradeName', 'nuit', 'phone', 'address', 'adminName', 'adminPassword', 'logo', 'updatedAt']))
      );
      allow delete: if isSuperAdmin();
    }

    // /erp_backups/{backupId}
    match /erp_backups/{backupId} {
      allow get: if isValidId(backupId) && isSuperAdmin();
      allow list: if isVerifiedFounder();
      allow create, update: if isValidId(backupId) && isSignedIn() && isValidCloudBackup(incoming());
      allow delete: if isSuperAdmin();
    }

    // /backups/{backupId}
    match /backups/{backupId} {
      allow get: if isValidId(backupId) && isSuperAdmin();
      allow list: if isVerifiedFounder();
      allow create, update: if isValidId(backupId) && isSignedIn() && isValidBackupRecord(incoming());
      allow delete: if isSuperAdmin();
    }

    // /erp_credential_requests/{requestId}
    match /erp_credential_requests/{requestId} {
      allow get: if isValidId(requestId) && (isSuperAdmin() || (isSignedIn() && resource.data.email == request.auth.token.email));
      allow list: if isVerifiedFounder() || (isSignedIn() && resource.data.email == request.auth.token.email);
      allow create: if isValidId(requestId) && isValidCredentialRequest(incoming()) && incoming().status in ['PENDENTE', 'PENDENTE_PAGAMENTO'];
      allow update: if isValidId(requestId) && isValidCredentialRequest(incoming()) && isSuperAdmin();
      allow delete: if isSuperAdmin();
    }

    // /credential_requests/{requestId}
    match /credential_requests/{requestId} {
      allow get: if isValidId(requestId) && (isSuperAdmin() || (isSignedIn() && resource.data.email == request.auth.token.email));
      allow list: if isVerifiedFounder() || (isSignedIn() && resource.data.email == request.auth.token.email);
      allow create: if isValidId(requestId) && isValidLandingCredentialRequest(incoming()) && incoming().status in ['PENDENTE', 'PENDENTE_PAGAMENTO'];
      allow update: if isValidId(requestId) && isValidLandingCredentialRequest(incoming()) && isSuperAdmin();
      allow delete: if isSuperAdmin();
    }

    // /companies/{companyId}
    match /companies/{companyId} {
      allow get: if isValidId(companyId) && (isSuperAdmin() || (isSignedIn() && resource.data.email == request.auth.token.email));
      allow list: if isVerifiedFounder() || (isSignedIn() && resource.data.email == request.auth.token.email);
      allow create: if isValidId(companyId) && isValidCompanyProfile(incoming())
        && (isSuperAdmin() || !('status' in incoming()) || incoming().status == 'pendente');
      allow update: if isValidId(companyId) && isValidCompanyProfile(incoming()) && (
        isSuperAdmin() ||
        (isSignedIn() && existing().email == request.auth.token.email && incoming().status == existing().status && incoming().diff(existing()).affectedKeys().hasOnly(['nome', 'nuit', 'endereco', 'pais', 'provincia', 'distrito', 'regime_iva', 'nuel', 'telefone', 'logo', 'updatedAt']))
      );
      allow delete: if isSuperAdmin();
    }

    // /support_tickets/{ticketId}
    match /support_tickets/{ticketId} {
      allow get: if isValidId(ticketId) && (isSuperAdmin() || (isSignedIn() && resource.data.email == request.auth.token.email));
      allow list: if isVerifiedFounder() || (isSignedIn() && resource.data.email == request.auth.token.email);
      allow create: if isValidId(ticketId) && isValidSupportTicket(incoming()) && incoming().id == ticketId && incoming().status == 'ABERTO';
      allow update, delete: if isSuperAdmin();
    }
  }
}
