# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and Webhook endpoints.
APP_URL="MY_APP_URL"

# =========================================================================
# GATEWAYS DE PAGAMENTO MÓVEL — MOÇAMBIQUE (CONFIGURE NOS SECRETS DO SERVIDOR)
# =========================================================================

# 1. Vodacom M-Pesa Open API (https://developer.mpesa.vm.co.mz)
# MPESA_ENV: "sandbox" ou "production"
MPESA_ENV="sandbox"
MPESA_API_KEY=""
MPESA_PUBLIC_KEY=""
MPESA_SHORTCODE=""
MPESA_ORIGIN="*"
MPESA_WEBHOOK_SECRET=""

# 2. Movitel e-Mola Corporate / Merchant API
# EMOLA_ENV: "sandbox" ou "production"
EMOLA_ENV="sandbox"
EMOLA_API_URL=""
EMOLA_PARTNER_CODE=""
EMOLA_API_KEY=""
EMOLA_SECRET_KEY=""
EMOLA_WEBHOOK_SECRET=""

# 3. Tmcel mKesh Enterprise API
# MKESH_ENV: "sandbox" ou "production"
MKESH_ENV="sandbox"
MKESH_API_URL=""
MKESH_MERCHANT_CODE=""
MKESH_CLIENT_ID=""
MKESH_CLIENT_SECRET=""
MKESH_WEBHOOK_SECRET=""

